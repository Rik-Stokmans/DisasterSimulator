{
  "name": "disaster-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "data:refresh": "node scripts/fetch-municipalities.mjs && node scripts/compress-lazy-region-assets.mjs",
    "data:realism": "node scripts/fetch-realism-data.mjs && node scripts/apply-audited-boundaries.mjs && node scripts/apply-audited-lifelines.mjs && node scripts/fetch-ndw-situations.mjs && node scripts/fetch-knmi-radar.mjs && node scripts/fetch-knmi-precipitation-probability.mjs && node scripts/fetch-knmi-observations.mjs && node scripts/fetch-knmi-warnings.mjs && node scripts/fetch-knmi-seismic-events.mjs && node scripts/fetch-rivm-acute-care.mjs && node scripts/fetch-duo-education-locations.mjs && node scripts/fetch-nbnl-capacity-context.mjs && node scripts/fetch-entsog-gts-flows.mjs && node scripts/fetch-rdi-antenna-sites.mjs && node scripts/fetch-rivm-air-quality.mjs && node scripts/fetch-rws-waterinfo.mjs && node scripts/fetch-rws-waterinfo-forecasts.mjs",
    "data:settlements": "node scripts/fetch-settlements.mjs && node scripts/compress-lazy-region-assets.mjs",
    "data:compress": "node scripts/compress-lazy-region-assets.mjs",
    "data:transit": "node scripts/fetch-transit.mjs --download --force && node scripts/apply-audited-lifelines.mjs",
    "data:water": "node scripts/fetch-water-assets.mjs",
    "data:facilities": "node scripts/fetch-public-facilities.mjs && node scripts/fetch-rivm-acute-care.mjs && node scripts/fetch-duo-education-locations.mjs",
    "data:acute-care": "node scripts/fetch-rivm-acute-care.mjs",
    "data:education": "node scripts/fetch-duo-education-locations.mjs",
    "data:telecom": "node scripts/fetch-rdi-antenna-sites.mjs",
    "data:air-quality": "node scripts/fetch-rivm-air-quality.mjs",
    "data:waterinfo": "node scripts/fetch-rws-waterinfo.mjs && node scripts/fetch-rws-waterinfo-forecasts.mjs",
    "data:ndw": "node scripts/fetch-ndw-situations.mjs",
    "data:knmi": "node scripts/fetch-knmi-radar.mjs && node scripts/fetch-knmi-precipitation-probability.mjs && node scripts/fetch-knmi-observations.mjs && node scripts/fetch-knmi-warnings.mjs",
    "data:knmi-precipitation-forecast": "node scripts/fetch-knmi-precipitation-probability.mjs",
    "data:earthquakes": "node scripts/fetch-knmi-seismic-events.mjs",
    "data:electricity": "node scripts/fetch-nbnl-capacity-context.mjs",
    "data:gas": "node scripts/fetch-entsog-gts-flows.mjs",
    "data:boundaries": "node scripts/apply-audited-boundaries.mjs",
    "data:lifelines": "node scripts/apply-audited-lifelines.mjs",
    "data:validate": "node scripts/validate-generated-data.mjs",
    "audit:manifest": "node scripts/generate-audit-manifest.mjs",
    "audit:guards": "node scripts/generate-audit-guards.mjs",
    "audit:context": "node scripts/municipality-audit-context.mjs",
    "audit:province-context": "node scripts/province-audit-context.mjs",
    "audit:model": "vitest run packages/sim-core/src/municipality-coverage.test.ts",
    "audit:status": "node scripts/generate-audit-manifest.mjs && node scripts/validate-audit-program.mjs --allow-incomplete",
    "audit:validate": "node scripts/generate-audit-manifest.mjs && node scripts/validate-audit-program.mjs",
    "dev": "pnpm --filter @disaster/web dev",
    "build": "pnpm --filter @disaster/web build",
    "preview": "pnpm --filter @disaster/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.0",
    "h5wasm": "0.10.1",
    "proj4": "^2.21.0",
    "shpjs": "^6.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
